    "This file is a genotype/rules catalogue, not a flat list of visible colours.",
    "A mutation must be represented at its locus; compound phenotypes are derived from multiple loci.",
    "Rare, disputed, historical, or source-dependent mutations are explicitly flagged.",
    "Phenotype masking must never remove underlying genotype information."
  ],
  "inheritance_types": {
    "autosomal_recessive": {
      "code": "AR",
      "description": "Two mutant alleles are normally required for visual expression."
    },
    "autosomal_incomplete_dominant": {
      "code": "AID",
      "description": "One mutant allele can alter phenotype; homozygous/double-factor states may differ."
    },
    "autosomal_dominant": {
      "code": "AD",
      "description": "One mutant allele is sufficient for expression."
    },
    "sex_linked_recessive": {
      "code": "ZLR",
      "description": "Z-linked recessive; males are ZZ and females are ZW."
    },
    "sex_linked_allelic_series": {
      "code": "ZAS",
      "description": "Multiple alleles occupy the same Z-linked locus and must be resolved by an allele dominance hierarchy."
    },
    "polygenic_or_uncertain": {
      "code": "POLY",
      "description": "Not safely representable as a simple Mendelian locus."
    },
    "compound": {
      "code": "CMP",
      "description": "Named phenotype produced by a defined combination of loci."
    },
    "experimental": {
      "code": "EXP",
      "description": "Rare, historical, disputed, or insufficiently standardized; disabled by default."
    }
  },
  "sex_system": {
    "male": "ZZ",
    "female": "ZW",
    "rules": [
      "Females have one Z-linked allele and cannot be split/carrier for a second recessive Z-linked allele in the usual Mendelian model.",
      "Males can be homozygous, heterozygous/split, or visual for Z-linked recessives.",
      "W carries no homologous allele for the Z-linked mutation loci in this model."
    ]
  },

  "epistasis_and_masking": [
    {
      "id": "ino_global_melanin_mask",
      "priority": 100,
      "rule": "Visual Ino removes eumelanin strongly enough that many melanistic/pattern mutations become visually masked or greatly reduced.",
      "affected_examples": [
        "Blackface",
        "Blackwing",
        "Cinnamon",
        "many pied/pattern expressions"
      ],
      "engine_action": "Keep underlying genotype; suppress or annotate visual expression."
    },
    {
      "id": "texas_clearbody_vs_ino",
      "priority": 95,
      "rule": "Texas Clearbody and Ino are alleles at the same Z-linked locus. A TCB/ino cock is phenotypically Texas Clearbody, not a simultaneous independent TCB + Ino bird.",
      "engine_action": "Resolve allele dominance before phenotype composition."
    },
    {
      "id": "opaline_masks_blackface",
      "priority": 80,
      "rule": "When both are visual, Opaline can substantially obscure the diagnostic Blackface pattern.",
      "engine_action": "Return genotype flags for both; phenotype renderer may show Opaline as primary visible pattern."
    },
    {
      "id": "yellowface_masked_by_green",
      "priority": 75,
      "rule": "Yellowface/Goldenface expression is primarily meaningful on blue/parblue backgrounds; on green-series birds the extra yellow is visually masked by existing yellow pigment.",
      "engine_action": "Do not discard the allele. Mark as genetically present but phenotypically masked."
    },
    {
      "id": "dark_eyed_clear_mask",
      "priority": 90,
      "rule": "Clearflight/Dutch Pied combined with homozygous Recessive Pied can produce a near-clear phenotype while the underlying pied genotypes remain.",
      "engine_action": "Create compound phenotype; preserve both loci."
    },
    {
      "id": "df_spangle_visual_masking",
      "priority": 70,
      "rule": "DF Spangle can greatly reduce visible body markings.",
      "engine_action": "Do not interpret reduced markings as absence of other underlying loci."
    },
    {
      "id": "dilution_allelic_resolution",
      "priority": 90,
      "rule": "Clearwing, Greywing and Dilute share the dilution locus and must be resolved as alleles before combining phenotypes.",
      "engine_action": "Never allow two alleles from the same locus to be independently selected as if they were separate genes."
    }
  ],
  "phenotype_pipeline": [
    "1. Validate sex and chromosome model.",
    "2. Resolve each parent's complete genotype, including confirmed splits.",
    "3. Generate gametes per locus, including Z-linked phase.",
    "4. Combine parental gametes into offspring genotypes.",
    "5. Resolve allelic-series dominance at each locus.",
    "6. Apply base colour / blue-parblue phenotype.",
    "7. Apply dark, grey and violet colour modifiers.",
    "8. Apply dilution-locus resolution.",
    "9. Apply pattern mutations such as Spangle, Opaline and Pied.",
    "10. Apply melanin/albinism mutations.",
    "11. Apply epistasis and masking rules in priority order.",
    "12. Derive display phenotype names from the surviving visible traits.",
    "13. Retain hidden genotype/split information separately.",
    "14. Aggregate genetically identical offspring outcomes and calculate probabilities.",
    "15. Optionally aggregate visually identical outcomes while exposing a 'hidden genetics' section."
  ],
